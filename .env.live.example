# Copy to .env on your Hetzner VPS (never commit this file):
#   cp .env.live.example .env
#
# Then paste your real values from Heroku Config Vars.
# DB_* below are overridden by docker-compose.live.yml to point at the postgres container.

APP_NAME="PL Tournament"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.pl-tournament.com

APP_RESTRICTIONS_ENABLED=true
APP_ADMIN_EMAIL=

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Docker Compose overrides DB_HOST to "postgres" — keep these matching postgres service creds
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=pl_tournament
DB_USERNAME=pl_tournament
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
CACHE_STORE=database

# AWS S3 (avatars) — copy from Heroku
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=pl-tournament-avatars

# Brevo email — copy from Heroku
MAIL_MAILER=brevo
BREVO_USERNAME=
BREVO_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Football APIs — copy from Heroku
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_API_KEY_SPARE_1=
FOOTBALL_DATA_API_KEY_SPARE_2=
FOOTBALL_DATA_API_KEY_SPARE_3=
FOOTBALL_API_KEY=
FOOTBALL_API_KEY_SPARE_1=
FOOTBALL_API_KEY_SPARE_2=
FOOTBALL_API_KEY_SPARE_3=
SPORTS_DB_API_KEY=
NEWS_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# Caddy SSL — comma-separated domains (no https://)
SITE_DOMAINS=www.pl-tournament.com,pl-tournament.com
